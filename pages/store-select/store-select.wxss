.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fff;
}
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  gap: 16rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
}
.search-icon { font-size: 28rpx; margin-right: 8rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.city-selector {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  white-space: nowrap;
}
.city-arrow { font-size: 20rpx; margin-left: 6rpx; color: var(--color-text-light); }

.map-container { height: 360rpx; overflow: hidden; }
.map { width: 100%; height: 100%; }

.store-list {
  flex: 1;
  padding: 0 30rpx;
}
.list-header { padding: 20rpx 0; }
.list-title { font-size: 28rpx; font-weight: bold; }

.store-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.store-info { margin-bottom: 16rpx; }
.store-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.store-name { font-size: 30rpx; font-weight: bold; }
.store-tags { display: flex; gap: 8rpx; }
.store-address { font-size: 24rpx; color: var(--color-text-secondary); display: block; margin-bottom: 8rpx; }
.store-meta { display: flex; align-items: center; gap: 20rpx; }
.store-hours { font-size: 24rpx; color: var(--color-text-light); }
.store-distance { font-size: 24rpx; color: var(--color-primary); }

.store-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.action-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.order-btn {
  margin-left: auto;
  background: var(--color-primary);
  color: #fff;
  padding: 14rpx 40rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}
.order-btn.disabled {
  background: #ccc;
  pointer-events: none;
}
