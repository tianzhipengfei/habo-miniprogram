.page { background: #fff; min-height: 100vh; padding-bottom: 160rpx; }
.image-swiper { width: 100%; height: 600rpx; }
.product-main-img { width: 100%; height: 600rpx; background: #f5f5f5; }
.product-main-img.single { height: 500rpx; }

.info-section { padding: 30rpx; border-bottom: 1rpx solid var(--color-border); }
.product-name { font-size: 34rpx; font-weight: bold; }
.product-meta { margin: 12rpx 0; }
.product-sales { font-size: 24rpx; color: var(--color-text-light); }
.product-desc { font-size: 26rpx; color: var(--color-text-secondary); display: block; margin: 12rpx 0; }
.price-row { display: flex; align-items: baseline; gap: 12rpx; margin-top: 16rpx; }
.original-price { font-size: 26rpx; color: var(--color-text-light); text-decoration: line-through; }

.detail-section { padding: 30rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; }

/* 底部 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 100;
}
.bottom-actions { display: flex; gap: 30rpx; margin-right: auto; }
.bottom-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.action-icon { font-size: 36rpx; }
.action-text { font-size: 20rpx; color: var(--color-text-light); }
.badge {
  position: absolute;
  top: -6rpx;
  right: -12rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 18rpx;
  min-width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  text-align: center;
  line-height: 28rpx;
}
.select-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.checkout-btn {
  background: #1a1a1a;
  color: #fff;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.closed-overlay {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.7);
  color: #fff;
  text-align: center;
  padding: 20rpx;
  z-index: 99;
}
.closed-hours { display: block; font-size: 22rpx; margin-top: 8rpx; opacity: 0.7; }
