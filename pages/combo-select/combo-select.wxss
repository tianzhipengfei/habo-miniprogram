.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fff;
}

.header {
  padding: 24rpx 30rpx 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.combo-name { font-size: 32rpx; font-weight: bold; display: block; }
.combo-hint {
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-top: 8rpx;
  display: block;
}

/* 滚动区 */
.option-scroll {
  flex: 1;
  padding: 0 30rpx;
}

/* 分组 */
.group-section {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.group-section:last-child {
  border-bottom: none;
}
.group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 16rpx;
}
.group-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--color-primary);
}
.group-limit {
  font-size: 22rpx;
  color: var(--color-text-light);
  background: var(--color-orange-light);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* 选项 */
.option-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.option-item.selected {
  background: var(--color-orange-light);
  margin: 0 -30rpx;
  padding: 16rpx 30rpx;
  border-radius: 8rpx;
}
.option-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.option-info {
  flex: 1;
  margin-left: 16rpx;
}
.option-name { font-size: 26rpx; }
.option-price {
  font-size: 24rpx;
  color: var(--color-primary);
  display: block;
  margin-top: 4rpx;
}
.option-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}
.option-check.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

/* 底部 */
.bottom-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}
.combo-summary { flex: 1; }
.summary-text { font-size: 26rpx; color: var(--color-text-secondary); display: block; }
.summary-price { font-size: 34rpx; color: var(--color-primary); font-weight: bold; }
.add-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 20rpx 50rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.add-btn.disabled {
  background: #ccc;
  pointer-events: none;
}
