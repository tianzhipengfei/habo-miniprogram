.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fff;
}

.header {
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.combo-name { font-size: 32rpx; font-weight: bold; color: #1a1a1a; }

/* 滚动区 */
.option-scroll {
  flex: 1;
  padding: 0 22rpx;
  box-sizing: border-box;
}

/* 分组 */
.group-section {
  margin-top: 28rpx;
}
.group-section:first-child {
  margin-top: 20rpx;
}
.group-title {
  padding: 12rpx 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
}

/* 三列网格 */
.option-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

/* 卡片 */
.option-card {
  width: calc(33.333% - 16rpx);
  margin: 0 8rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
  transition: all .2s;
}
.option-card.selected {
  box-shadow: 0 0 0 3rpx var(--color-primary);
  transform: scale(0.98);
}
.option-card.sold-out {
  opacity: 0.65;
}
.option-card.sold-out .card-img {
  filter: grayscale(80%);
}

/* 图片区 - 正方形 */
.card-img-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: #f5f5f5;
}
.card-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx 12rpx 0 0;
}

/* 选中勾 */
.card-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.8);
  background: rgba(0,0,0,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
}
.card-check.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

/* 名称 */
.card-name {
  padding: 12rpx 12rpx 6rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: #1a1a1a;
  min-height: 68rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 底部：价格 / 售罄 / 箭头 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 14rpx;
  min-height: 48rpx;
}
.card-price {
  font-size: 24rpx;
  color: #666;
}
.sold-out-text {
  font-size: 24rpx;
  color: #999;
}
.arrow-btn {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.arrow-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  transform: translateX(1rpx);
}

/* 底部占位，防止内容被 bottom-bar 遮挡 */
.bottom-placeholder {
  height: 140rpx;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.08);
}

/* 购物车图标 */
.cart-icon-wrap {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cart-icon {
  width: 44rpx;
  height: 44rpx;
}
.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 价格 */
.combo-summary {
  flex: 1;
  margin-left: 24rpx;
}
.summary-price {
  font-size: 40rpx;
  color: #1a1a1a;
  font-weight: bold;
}

/* 加入购物车按钮 */
.add-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 20rpx 36rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.add-btn.disabled {
  background: #d1d1d1;
  color: #fff;
}
