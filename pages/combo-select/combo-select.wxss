.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
  overflow: hidden;
  background: #fff;
}

.header {
  flex-shrink: 0;
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.combo-name { font-size: 32rpx; font-weight: bold; color: #1a1a1a; }

/* 滚动区
   height:0 + flex:1 是关键：flex 子项默认 min-height:auto，
   内容多时 scroll-view 会被撑高、底部内容藏到 bottom-bar 后面 */
.option-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
}

/* 滚动区底部留白，最后一行卡片不贴 bottom-bar */
.group-section:last-child {
  padding-bottom: 30rpx;
}

/* 分组 */
.group-section {
  margin-top: 28rpx;
}
.group-section:first-child {
  margin-top: 20rpx;
}
.group-title {
  padding: 12rpx 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
}

/* 三列网格（不依赖负 margin，避免横向溢出） */
.option-grid {
  display: flex;
  flex-wrap: wrap;
}

/* 卡片：宽度 = 1/3 - 间距，左右 margin 各 7rpx 制造列间距，三列之和正好 100% */
.option-card {
  width: calc(33.333% - 14rpx);
  margin: 0 7rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
  transition: all .2s;
}
.option-card.selected {
  box-shadow: 0 0 0 3rpx var(--color-primary);
  background: #fff7ed;
}
.option-card.sold-out {
  opacity: 0.65;
}
.option-card.sold-out .card-img {
  filter: grayscale(80%);
}

/* 图片区 - 正方形 */
.card-img-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: #f5f5f5;
}
.card-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx 12rpx 0 0;
}

/* 选中勾 */
.card-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.8);
  background: rgba(0,0,0,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
}
.card-check.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

/* 名称 */
.card-name {
  padding: 12rpx 12rpx 6rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: #1a1a1a;
  min-height: 68rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 底部：价格 / 售罄 / 箭头 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 14rpx;
  min-height: 48rpx;
}
.card-price {
  font-size: 24rpx;
  color: #666;
}
.sold-out-text {
  font-size: 24rpx;
  color: #999;
}
.arrow-btn {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.arrow-icon {
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  line-height: 36rpx;
  transform: translateX(-1rpx);
}

/* 无定制项时的"+"加购按钮 */
.add-one-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.plus-icon {
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  line-height: 40rpx;
  transform: translateY(-2rpx);
}

/* 底部栏：普通文档流，作为 flex column 末项；
   option-scroll 用 flex:1 自动让出本栏高度，不再遮挡内容 */
.bottom-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.08);
  /* 高于弹层遮罩(90)与面板(95)，弹层打开时底栏仍可点击 */
  position: relative;
  z-index: 100;
}

/* 购物车图标 */
.cart-icon-wrap {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cart-icon {
  width: 44rpx;
  height: 44rpx;
}
.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 价格 */
.combo-summary {
  flex: 1;
  margin-left: 24rpx;
}
.summary-price {
  font-size: 40rpx;
  color: #1a1a1a;
  font-weight: bold;
}

/* 加入购物车按钮 */
.add-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 20rpx 36rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.add-btn.disabled {
  background: #d1d1d1;
  color: #fff;
}

/* 当前已选弹层（与点单页购物车面板同风格） */
.cart-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(0, 0, 0, 0);
  transition: background 0.25s ease;
  pointer-events: none;
}
.cart-panel-mask.show {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}
.cart-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  z-index: 95;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(120%);
  visibility: hidden;
  transition: transform 0.25s ease, visibility 0.25s;
  display: flex;
  flex-direction: column;
  height: 70vh;
}
.cart-panel.show {
  transform: translateY(0);
  visibility: visible;
}
.cart-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.cart-panel-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
}
.cart-panel-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.close-icon {
  font-size: 40rpx;
  color: #999;
  line-height: 48rpx;
}
.cart-panel-list {
  flex: 1;
  height: 0;
  padding: 0 30rpx;
  box-sizing: border-box;
}
.cart-panel-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.cart-panel-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.cart-panel-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}
.cart-panel-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-panel-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-panel-right {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
}
.cart-panel-extra {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: bold;
}
.cart-panel-del {
  margin-top: 8rpx;
  padding: 8rpx;
}
.del-icon {
  font-size: 32rpx;
  color: #999;
}
.cart-panel-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999;
}
