.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fff;
}
.header {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.combo-name { font-size: 32rpx; font-weight: bold; }

.group-tabs {
  white-space: nowrap;
  padding: 16rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.group-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 26rpx;
}
.group-tab.active {
  background: var(--color-orange-light);
  color: var(--color-primary);
  font-weight: bold;
}
.group-progress {
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
}
.group-tab.active .group-progress { color: var(--color-primary); }

.option-list { flex: 1; padding: 0 30rpx; }
.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.option-item.selected { background: var(--color-orange-light); margin: 0 -30rpx; padding: 24rpx 30rpx; }
.option-img { width: 100rpx; height: 100rpx; border-radius: 12rpx; background: #f5f5f5; }
.option-info { flex: 1; margin-left: 20rpx; }
.option-name { font-size: 28rpx; }
.option-price { font-size: 26rpx; color: var(--color-primary); display: block; margin-top: 6rpx; }
.option-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}
.option-check.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.bottom-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}
.combo-summary { flex: 1; }
.summary-text { font-size: 26rpx; color: var(--color-text-secondary); display: block; }
.summary-price { font-size: 34rpx; color: var(--color-primary); font-weight: bold; }
.add-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 20rpx 50rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.add-btn.disabled {
  background: #ccc;
  pointer-events: none;
}
