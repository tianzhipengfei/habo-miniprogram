.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.header {
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
}
.combo-name { font-size: 32rpx; font-weight: bold; }

/* Tab 栏 */
.tab-bar {
  white-space: nowrap;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border);
}
.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.tab-item.active {
  background: var(--color-primary);
  color: #fff;
}
.tab-progress {
  font-size: 20rpx;
  margin-top: 4rpx;
  opacity: 0.7;
}

/* 选项滚动区 */
.option-scroll {
  flex: 1;
  padding: 20rpx 20rpx 0;
}

/* 选项网格 - 两列 */
.option-grid {
  display: inline-block;
  width: 50%;
  padding: 0 8rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  vertical-align: top;
}

/* 选项卡片 */
.option-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: all .2s;
}
.option-card.selected {
  box-shadow: 0 0 0 3rpx var(--color-primary);
  transform: scale(0.97);
}
.option-card.sold-out {
  opacity: 0.6;
}

/* 图片区 70% */
.card-img-wrap {
  position: relative;
  width: 100%;
  padding-top: 90%;
  background: #f0f0f0;
}
.card-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}

/* 售罄遮罩 */
.sold-out-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sold-out-mask text {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  border: 2rpx solid #fff;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
}

/* 选中勾 */
.card-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.8);
  background: rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
}
.card-check.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

/* 名称 */
.card-name {
  padding: 12rpx 12rpx 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 12rpx 14rpx;
}
.card-price {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: bold;
}
.sold-out-text {
  font-size: 24rpx;
  color: var(--color-text-light);
}
.custom-btn {
  background: var(--color-orange-light);
  color: var(--color-primary);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 底部栏 */
.bottom-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}
.combo-summary { flex: 1; }
.summary-text { font-size: 24rpx; color: var(--color-text-secondary); display: block; }
.summary-price { font-size: 32rpx; color: var(--color-primary); font-weight: bold; }
.add-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 18rpx 44rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.add-btn.disabled {
  background: #ccc;
  pointer-events: none;
}
