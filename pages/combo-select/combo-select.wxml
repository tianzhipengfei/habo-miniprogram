<!-- 套餐选择页：上下堆叠分组，每组三列卡片 -->
<view class="page">
  <view class="header">
    <text class="combo-name">{{product.name}}</text>
  </view>

  <scroll-view class="option-scroll" scroll-y>
    <!-- 汉堡分组 -->
    <view class="group-section" wx:if="{{burgerGroup}}">
      <view class="group-title">
        <text>{{burgerGroup.name}}（{{selectedMap[burgerGroup.id] ? selectedMap[burgerGroup.id].length : 0}}/{{burgerGroup.max_select}}）</text>
      </view>
      <view class="option-grid">
        <view
          class="option-card {{isSelected(burgerGroup.id, opt.id) ? 'selected' : ''}} {{opt.product.stock === 0 ? 'sold-out' : ''}}"
          wx:for="{{burgerGroup.options}}"
          wx:for-item="opt"
          wx:key="id"
          bindtap="toggleOption"
          data-group-id="{{burgerGroup.id}}"
          data-option="{{opt}}"
        >
          <view class="card-img-wrap">
            <image class="card-img" src="{{opt.product.image}}" mode="aspectFill" />
            <view class="card-check {{isSelected(burgerGroup.id, opt.id) ? 'checked' : ''}}">
              <text wx:if="{{isSelected(burgerGroup.id, opt.id)}}">✓</text>
            </view>
          </view>
          <view class="card-name">{{opt.product.name}}</view>
          <view class="card-footer">
            <block wx:if="{{opt.product.stock === 0}}">
              <text class="sold-out-text">已售罄</text>
            </block>
            <block wx:else>
              <text class="card-price">¥{{opt.product.priceText}}</text>
              <view
                class="arrow-btn"
                catchtap="onCustomBtnTap"
                data-group-id="{{burgerGroup.id}}"
                data-option="{{opt}}"
              >
                <text class="arrow-icon">›</text>
              </view>
            </block>
          </view>
        </view>
      </view>
    </view>

    <!-- 饮品/小吃等实际分组 -->
    <view class="group-section" wx:for="{{comboGroups}}" wx:key="id" wx:for-item="group" wx:for-index="gi">
      <view class="group-title">
        <text>{{group.name}} 任选{{group.max_select}}项（{{selectedMap[group.id] ? selectedMap[group.id].length : 0}}/{{group.max_select}}）</text>
      </view>
      <view class="option-grid">
        <view
          class="option-card {{isSelected(group.id, opt.id) ? 'selected' : ''}} {{opt.product.stock === 0 ? 'sold-out' : ''}}"
          wx:for="{{group.options}}"
          wx:for-item="opt"
          wx:key="id"
          bindtap="toggleOption"
          data-group-id="{{group.id}}"
          data-option="{{opt}}"
        >
          <view class="card-img-wrap">
            <image class="card-img" src="{{opt.product.image}}" mode="aspectFill" />
            <view class="card-check {{isSelected(group.id, opt.id) ? 'checked' : ''}}">
              <text wx:if="{{isSelected(group.id, opt.id)}}">✓</text>
            </view>
          </view>
          <view class="card-name">{{opt.product.name}}</view>
          <view class="card-footer">
            <block wx:if="{{opt.product.stock === 0}}">
              <text class="sold-out-text">已售罄</text>
            </block>
            <block wx:else>
              <text class="card-price">¥{{opt.product.priceText}}</text>
              <view
                class="arrow-btn"
                catchtap="onCustomBtnTap"
                data-group-id="{{group.id}}"
                data-option="{{opt}}"
              >
                <text class="arrow-icon">›</text>
              </view>
            </block>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- 底部栏 -->
  <view class="bottom-bar">
    <view class="cart-icon-wrap">
      <image class="cart-icon" src="/images/menu/icon-cart.png" mode="aspectFit" />
      <view class="cart-badge">{{totalSelected}}/{{totalRequired}}</view>
    </view>
    <view class="combo-summary">
      <text class="summary-price">¥{{comboPriceText}}</text>
    </view>
    <view
      class="add-btn {{totalSelected < totalRequired ? 'disabled' : ''}}"
      bindtap="addToCart"
    >加入购物车</view>
  </view>
</view>
