<!-- 套餐选择页 -->
<view class="page">
  <view class="header">
    <text class="combo-name">{{product.name}}</text>
    <text class="combo-hint">请选择套餐内容（共 {{totalRequired}} 项）</text>
  </view>

  <!-- 所有分组上下堆叠 -->
  <scroll-view class="option-scroll" scroll-y>
    <view class="group-section" wx:for="{{comboGroups}}" wx:key="id" wx:for-index="gi">
      <view class="group-title">
        <text class="group-name">{{item.name}}</text>
        <text class="group-limit">选 {{item.max_select}} 项</text>
      </view>
      <view
        class="option-item {{isSelected(gi, opt.id) ? 'selected' : ''}}"
        wx:for="{{item.options}}"
        wx:for-item="opt"
        wx:key="id"
        bindtap="toggleOption"
        data-group-index="{{gi}}"
        data-option="{{opt}}"
      >
        <image class="option-img" src="{{opt.product.image}}" mode="aspectFill" />
        <view class="option-info">
          <text class="option-name">{{opt.product.name}}</text>
          <text class="option-price">¥{{opt.product.price}} {{opt.extra_price > 0 ? '+¥' + opt.extra_price : ''}}</text>
        </view>
        <view class="option-check {{isSelected(gi, opt.id) ? 'checked' : ''}}">
          <text wx:if="{{isSelected(gi, opt.id)}}">✓</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部 -->
  <view class="bottom-bar">
    <view class="combo-summary">
      <text class="summary-text">已选 {{totalSelected}}/{{totalRequired}} 项</text>
      <text class="summary-price">¥{{comboPrice}}</text>
    </view>
    <view class="add-btn {{totalSelected < totalRequired ? 'disabled' : ''}}" bindtap="addToCart">
      <text>加入购物车</text>
    </view>
  </view>
</view>
