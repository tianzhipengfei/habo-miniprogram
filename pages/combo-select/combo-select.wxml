<!-- 套餐选择页：上下堆叠分组，每组三列卡片 -->
<view class="page">
  <view class="header">
    <text class="combo-name">{{product.name}}</text>
  </view>

  <scroll-view class="option-scroll" scroll-y>
    <!-- 汉堡分组 -->
    <view class="group-section" wx:if="{{burgerGroup}}">
      <view class="group-title">
        <text>{{burgerGroup.name}}（{{selectedMap[burgerGroup.id] ? selectedMap[burgerGroup.id].length : 0}}/{{burgerGroup.max_select}}）</text>
      </view>
      <view class="option-grid">
        <view
          class="option-card {{opt.selected ? 'selected' : ''}} {{opt.product.stock === 0 ? 'sold-out' : ''}}"
          wx:for="{{burgerGroup.options}}"
          wx:for-item="opt"
          wx:key="id"
          bindtap="toggleOption"
          data-group-id="{{burgerGroup.id}}"
          data-option-id="{{opt.id}}"
        >
          <view class="card-img-wrap">
            <image class="card-img" src="{{opt.product.image}}" mode="aspectFill" />
            <view class="card-check {{opt.selected ? 'checked' : ''}}">
              <text wx:if="{{opt.selected}}">✓</text>
            </view>
          </view>
          <view class="card-name">{{opt.product.name}}</view>
          <view class="card-footer">
            <block wx:if="{{opt.product.stock === 0}}">
              <text class="sold-out-text">已售罄</text>
            </block>
            <block wx:else>
              <text class="card-price">¥{{opt.product.priceText}}</text>
              <block wx:if="{{opt.product.custom_options && opt.product.custom_options.length > 0}}">
                <view class="arrow-btn" catchtap="onCustomBtnTap" data-group-id="{{burgerGroup.id}}" data-option-id="{{opt.id}}">
                  <text class="arrow-icon">›</text>
                </view>
              </block>
              <block wx:else>
                <view class="add-one-btn" catchtap="toggleOption" data-group-id="{{burgerGroup.id}}" data-option-id="{{opt.id}}">
                  <text class="plus-icon">+</text>
                </view>
              </block>
            </block>
          </view>
        </view>
      </view>
    </view>

    <!-- 饮品/小吃等实际分组 -->
    <view class="group-section" wx:for="{{comboGroups}}" wx:key="id" wx:for-item="group" wx:for-index="gi">
      <view class="group-title">
        <text>{{group.name}} 任选{{group.max_select}}项（{{selectedMap[group.id] ? selectedMap[group.id].length : 0}}/{{group.max_select}}）</text>
      </view>
      <view class="option-grid">
        <view
          class="option-card {{opt.selected ? 'selected' : ''}} {{opt.product.stock === 0 ? 'sold-out' : ''}}"
          wx:for="{{group.options}}"
          wx:for-item="opt"
          wx:key="id"
          bindtap="toggleOption"
          data-group-id="{{group.id}}"
          data-option-id="{{opt.id}}"
        >
          <view class="card-img-wrap">
            <image class="card-img" src="{{opt.product.image}}" mode="aspectFill" />
            <view class="card-check {{opt.selected ? 'checked' : ''}}">
              <text wx:if="{{opt.selected}}">✓</text>
            </view>
          </view>
          <view class="card-name">{{opt.product.name}}</view>
          <view class="card-footer">
            <block wx:if="{{opt.product.stock === 0}}">
              <text class="sold-out-text">已售罄</text>
            </block>
            <block wx:else>
              <text class="card-price">¥{{opt.product.priceText}}</text>
              <block wx:if="{{opt.product.custom_options && opt.product.custom_options.length > 0}}">
                <view class="arrow-btn" catchtap="onCustomBtnTap" data-group-id="{{group.id}}" data-option-id="{{opt.id}}">
                  <text class="arrow-icon">›</text>
                </view>
              </block>
              <block wx:else>
                <view class="add-one-btn" catchtap="toggleOption" data-group-id="{{group.id}}" data-option-id="{{opt.id}}">
                  <text class="plus-icon">+</text>
                </view>
              </block>
            </block>
          </view>
        </view>
      </view>
    </view>

  </scroll-view>

  <!-- 底部栏 -->
  <view class="bottom-bar">
    <view class="cart-icon-wrap" bindtap="toggleCartPanel">
      <image class="cart-icon" src="/images/menu/icon-cart.png" mode="aspectFit" />
      <view class="cart-badge">{{totalSelected}}/{{totalRequired}}</view>
    </view>
    <view class="combo-summary" bindtap="toggleCartPanel">
      <text class="summary-price">¥{{comboPriceText}}</text>
    </view>
    <view
      class="add-btn {{totalSelected < totalRequired ? 'disabled' : ''}}"
      bindtap="addToCart"
    >加入购物车</view>
  </view>

  <!-- 当前已选弹层遮罩 -->
  <view class="cart-panel-mask {{showCartPanel ? 'show' : ''}}" bindtap="closeCartPanel"></view>

  <!-- 当前已选弹层内容 -->
  <view class="cart-panel {{showCartPanel ? 'show' : ''}}" catchtap="noop">
    <view class="cart-panel-header">
      <text class="cart-panel-title">当前已选（{{totalSelected}}/{{totalRequired}}）</text>
      <view class="cart-panel-close" bindtap="closeCartPanel">
        <text class="close-icon">×</text>
      </view>
    </view>
    <scroll-view class="cart-panel-list" scroll-y>
      <view class="cart-panel-item" wx:for="{{panelItems}}" wx:key="optionId">
        <image class="cart-panel-img" src="{{item.image}}" mode="aspectFill" />
        <view class="cart-panel-info">
          <text class="cart-panel-name">{{item.name}}</text>
          <text class="cart-panel-spec">{{item.groupName}} · {{item.specText}}</text>
        </view>
        <view class="cart-panel-right">
          <text class="cart-panel-extra" wx:if="{{item.extraText}}">{{item.extraText}}</text>
          <view class="cart-panel-del" bindtap="removePanelItem" data-group-id="{{item.groupId}}" data-option-id="{{item.optionId}}">
            <text class="del-icon">🗑</text>
          </view>
        </view>
      </view>
      <view class="cart-panel-empty" wx:if="{{panelItems.length === 0}}">
        <text>还没有选择内容</text>
      </view>
    </scroll-view>
  </view>
</view>
