<!-- 套餐选择页 -->
<view class="page">
  <view class="header">
    <text class="combo-name">{{product.name}}</text>
  </view>

  <!-- 分组 Tab -->
  <scroll-view class="group-tabs" scroll-x>
    <view
      class="group-tab {{currentGroup === index ? 'active' : ''}}"
      wx:for="{{comboGroups}}"
      wx:key="id"
      wx:for-index="index"
      bindtap="switchGroup"
      data-index="{{index}}"
    >
      <text>{{item.name}}</text>
      <text class="group-progress">{{selectedMap[item.id] ? selectedMap[item.id].length : 0}}/{{item.max_select}}</text>
    </view>
  </scroll-view>

  <!-- 当前分组可选商品 -->
  <scroll-view class="option-list" scroll-y>
    <view
      class="option-item {{isSelected(currentGroup, item.id) ? 'selected' : ''}}"
      wx:for="{{currentOptions}}"
      wx:key="id"
      bindtap="toggleOption"
      data-option="{{item}}"
    >
      <image class="option-img" src="{{item.product.image}}" mode="aspectFill" />
      <view class="option-info">
        <text class="option-name">{{item.product.name}}</text>
        <text class="option-price">¥{{item.product.price}} {{item.extra_price > 0 ? '+¥' + item.extra_price : ''}}</text>
      </view>
      <view class="option-check {{isSelected(currentGroup, item.id) ? 'checked' : ''}}">
        <text wx:if="{{isSelected(currentGroup, item.id)}}">✓</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部 -->
  <view class="bottom-bar">
    <view class="combo-summary">
      <text class="summary-text">已选 {{totalSelected}}/{{totalRequired}} 项</text>
      <text class="summary-price">¥{{comboPrice}}</text>
    </view>
    <view class="add-btn {{totalSelected < totalRequired ? 'disabled' : ''}}" bindtap="addToCart">
      <text>加入购物车</text>
    </view>
  </view>
</view>
