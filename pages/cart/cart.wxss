.page { height: 100vh; display: flex; flex-direction: column; background: #fff; }
.empty-cart { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: var(--color-text-light); margin-top: 20rpx; }

.cart-list { flex: 1; padding: 0 30rpx; }
.cart-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-border); }
.item-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #f5f5f5; }
.item-info { flex: 1; margin-left: 20rpx; }
.item-name { font-size: 28rpx; }
.item-price { font-size: 26rpx; color: var(--color-primary); display: block; margin-top: 8rpx; }

.quantity-control { display: flex; align-items: center; gap: 12rpx; }
.qty-btn { width: 48rpx; height: 48rpx; border-radius: 50%; border: 1rpx solid #ddd; display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: var(--color-text-secondary); }
.qty-num { font-size: 28rpx; min-width: 40rpx; text-align: center; }

.bottom-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}
.total-info { flex: 1; }
.total-label { font-size: 26rpx; color: var(--color-text-light); display: block; }
.checkout-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}
