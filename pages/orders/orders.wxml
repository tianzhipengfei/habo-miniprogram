<!-- 订单页 -->
<view class="page">
  <!-- 日期 Tab -->
  <view class="date-tabs">
    <view class="date-tab {{dateType === 'today' ? 'active' : ''}}" bindtap="switchDate" data-type="today">今日订单</view>
    <view class="date-tab {{dateType === 'history' ? 'active' : ''}}" bindtap="switchDate" data-type="history">历史订单</view>
  </view>

  <!-- 类型筛选 -->
  <scroll-view class="type-filters" scroll-x>
    <view class="type-filter {{!orderTypeFilter ? 'active' : ''}}" bindtap="filterType" data-type="">全部</view>
    <view class="type-filter {{orderTypeFilter === 1 ? 'active' : ''}}" bindtap="filterType" data-type="1">堂食</view>
    <view class="type-filter {{orderTypeFilter === 2 ? 'active' : ''}}" bindtap="filterType" data-type="2">打包</view>
    <view class="type-filter {{orderTypeFilter === 3 ? 'active' : ''}}" bindtap="filterType" data-type="3">快餐</view>
    <view class="type-filter {{orderTypeFilter === 4 ? 'active' : ''}}" bindtap="filterType" data-type="4">当面付</view>
    <view class="type-filter {{orderTypeFilter === 5 ? 'active' : ''}}" bindtap="filterType" data-type="5">排队</view>
    <view class="type-filter {{orderTypeFilter === 6 ? 'active' : ''}}" bindtap="filterType" data-type="6">预约</view>
    <view class="type-filter {{orderTypeFilter === 7 ? 'active' : ''}}" bindtap="filterType" data-type="7">快递</view>
  </scroll-view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-store">{{item.store_name || '门店'}}</text>
        <text class="order-time">{{item.created_at}}</text>
      </view>
      <view class="order-status-bar">
        <text class="order-status {{item.status === 1 ? 'paid' : item.status === 0 ? 'pending' : ''}}">
          {{statusText[item.status] || '未知'}}
        </text>
        <text class="order-type-tag" wx:if="{{item.order_type}}">{{typeText[item.order_type] || ''}}订单</text>
      </view>
      <view wx:if="{{item.table_no}}" class="order-table">
        <text>桌号：{{item.table_no}} | {{item.people_count}}位</text>
      </view>
      <view class="order-item" wx:for="{{item.items}}" wx:key="id" wx:for-item="oi">
        <image class="oi-img" src="{{oi.product_image}}" mode="aspectFill" />
        <view class="oi-info">
          <text class="oi-name">{{oi.product_name}}</text>
          <text class="oi-price">¥{{oi.price}}</text>
        </view>
        <text class="oi-qty">共{{oi.quantity}}件</text>
      </view>
      <view class="order-footer">
        <text class="order-total">合计 ¥{{item.pay_amount}}</text>
        <view class="contact-btn" catchtap="contactStore">联系商家</view>
      </view>
    </view>
  </scroll-view>

  <empty-state wx:else text="暂无订单" />
</view>
