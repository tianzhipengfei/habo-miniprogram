.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 40rpx; }

.balance-header {
  background: linear-gradient(135deg, #E8420F, #F57235);
  padding: 50rpx 30rpx;
  text-align: center;
  color: #fff;
}
.balance-label { font-size: 24rpx; opacity: 0.8; display: block; }
.balance-value { font-size: 64rpx; font-weight: bold; display: block; margin-top: 8rpx; }

.plan-section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; display: block; }

.plan-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.plan-item {
  width: calc(50% - 8rpx);
  padding: 30rpx 0;
  border-radius: 16rpx;
  background: #f8f8f8;
  text-align: center;
  border: 2rpx solid transparent;
}
.plan-item.active {
  background: var(--color-orange-light);
  border-color: var(--color-primary);
}
.plan-amount { font-size: 36rpx; font-weight: bold; display: block; }
.plan-bonus { font-size: 24rpx; color: var(--color-primary); display: block; margin: 4rpx 0; }
.plan-label { font-size: 22rpx; color: var(--color-text-light); }

.custom-amount { margin-top: 30rpx; }
.custom-label { font-size: 28rpx; color: var(--color-text-secondary); display: block; margin-bottom: 12rpx; }
.custom-input {
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.submit-section { padding: 0 20rpx; }
.recharge-summary { text-align: center; padding: 20rpx 0; }
.summary-text { font-size: 26rpx; color: var(--color-text-secondary); }

.records { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; }
.record-item { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--color-border); }
.record-item:last-child { border-bottom: none; }
.record-amount { font-size: 28rpx; font-weight: 500; }
.record-bonus { font-size: 22rpx; color: var(--color-primary); margin-left: 12rpx; }
.record-time { font-size: 24rpx; color: var(--color-text-light); }
