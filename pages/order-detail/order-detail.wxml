<!-- 订单详情页 -->
<view class="page">
  <view class="status-card" wx:if="{{order.status !== undefined}}">
    <text class="status-icon">{{statusIcon[order.status] || '📋'}}</text>
    <text class="status-text">{{statusText[order.status] || '未知'}}</text>
    <text class="status-desc" wx:if="{{order.status === 0}}">请尽快完成支付</text>
    <text class="status-desc" wx:if="{{order.status === 1}}">商家正在准备中</text>
    <view class="pay-btn btn btn-primary" wx:if="{{order.status === 0}}" bindtap="payAgain">立即支付</view>
  </view>

  <view class="section">
    <view class="section-title">订单信息</view>
    <view class="info-row"><text class="l">订单编号</text><text class="r">{{order.order_no}}</text></view>
    <view class="info-row"><text class="l">下单时间</text><text class="r">{{order.created_at}}</text></view>
    <view class="info-row"><text class="l">用餐方式</text><text class="r">{{typeText[order.order_type]}}</text></view>
    <view class="info-row" wx:if="{{order.table_no}}"><text class="l">桌号</text><text class="r">{{order.table_no}}</text></view>
  </view>

  <view class="section">
    <view class="section-title">商品明细</view>
    <view class="order-item" wx:for="{{items}}" wx:key="id">
      <image class="item-img" src="{{item.product_image}}" mode="aspectFill" />
      <view class="item-info">
        <text class="item-name">{{item.product_name}}</text>
        <text class="item-qty">x{{item.quantity}}</text>
      </view>
      <text class="item-price">¥{{item.price * item.quantity}}</text>
    </view>
  </view>

  <view class="section">
    <view class="amount-row"><text class="l">商品小计</text><text class="r">¥{{order.total_amount}}</text></view>
    <view class="amount-row" wx:if="{{order.discount_amount > 0}}"><text class="l">优惠券</text><text class="r text-primary">-¥{{order.discount_amount}}</text></view>
    <view class="amount-row" wx:if="{{order.balance_used > 0}}"><text class="l">余额抵扣</text><text class="r text-primary">-¥{{order.balance_used}}</text></view>
    <view class="amount-row total"><text class="l">实付金额</text><text class="r price">¥{{order.pay_amount}}</text></view>
  </view>

  <view class="cancel-btn" wx:if="{{order.status === 0}}" bindtap="cancelOrder">取消订单</view>
</view>
