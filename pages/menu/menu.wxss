.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fff;
}

/* 门店条 */
.store-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #1a1a1a;
}
.store-name { color: #fff; font-size: 28rpx; font-weight: 500; }
.store-distance { color: #ccc; font-size: 24rpx; margin-left: 12rpx; }
.switch-store { color: var(--color-primary); font-size: 24rpx; }

/* 公告 */
.notice-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx;
  background: var(--color-orange-light);
}
.notice-text { font-size: 24rpx; color: var(--color-text); }
.notice-more { font-size: 22rpx; color: var(--color-primary); }

/* 推荐 */
.recommend-row {
  white-space: nowrap;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.recommend-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  width: 160rpx;
}
.rec-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}
.rec-name {
  font-size: 22rpx;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140rpx;
}
.rec-price {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: bold;
}

/* 内容区 */
.content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 分类 */
.category-list {
  width: 180rpx;
  background: #f8f8f8;
  height: 100%;
}
.category-item {
  padding: 30rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  position: relative;
}
.category-item.active {
  background: #fff;
  color: var(--color-primary);
  font-weight: bold;
}
.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: var(--color-primary);
  border-radius: 0 3rpx 3rpx 0;
}

/* 商品列表 */
.product-list {
  flex: 1;
  height: 100%;
  padding: 0 20rpx;
}
.product-card {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.product-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.product-name { font-size: 28rpx; font-weight: 500; }
.product-desc { font-size: 22rpx; color: var(--color-text-light); }
.product-sales { font-size: 22rpx; color: var(--color-text-light); }
.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.product-price { font-size: 30rpx; color: var(--color-primary); font-weight: bold; }
.price-from { font-size: 22rpx; color: var(--color-text-light); font-weight: normal; }
.select-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

/* 未选门店 */
.no-store {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
}
.no-store-icon { width: 120rpx; height: 120rpx; opacity: 0.3; }
.no-store-text { font-size: 28rpx; color: var(--color-text-light); }

/* 门店休息遮罩 */
.closed-overlay {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.7);
  color: #fff;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  z-index: 50;
}
.closed-hours { display: block; font-size: 22rpx; margin-top: 8rpx; opacity: 0.7; }

/* 购物车栏 */
.cart-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background: #1a1a1a;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.cart-icon-wrap { position: relative; margin-right: 20rpx; }
.cart-icon { font-size: 48rpx; }
.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 32rpx;
  padding: 0 6rpx;
}
.cart-price { flex: 1; }
.cart-price .price { color: #fff; font-size: 32rpx; font-weight: bold; }
.checkout-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 16rpx 50rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.checkout-btn.disabled {
  background: #555;
  pointer-events: none;
}
