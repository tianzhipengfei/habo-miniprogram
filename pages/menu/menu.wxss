.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fff;
}

/* 门店条 - 橙色系 */
.store-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #E8420F, #F57235);
}
.store-info {
  display: flex;
  align-items: center;
}
.store-name { color: #fff; font-size: 28rpx; font-weight: 500; }
.store-distance { color: rgba(255,255,255,0.7); font-size: 24rpx; margin-left: 12rpx; }
.switch-store { color: #fff; font-size: 24rpx; opacity: 0.9; }

/* 公告 */
.notice-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx;
  background: var(--color-orange-light);
}
.notice-text { font-size: 24rpx; color: var(--color-text); }
.notice-more { font-size: 22rpx; color: var(--color-primary); }

/* 推荐 */
.recommend-row {
  white-space: nowrap;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.recommend-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  width: 160rpx;
}
.rec-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}
.rec-name {
  font-size: 22rpx;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140rpx;
}
.rec-price {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: bold;
}

/* 内容区 */
.content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 分类 */
.category-list {
  width: 180rpx;
  background: #f8f8f8;
  height: 100%;
}
.category-item {
  padding: 24rpx 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.category-icon {
  width: 48rpx;
  height: 48rpx;
}
.category-item.active {
  background: #fff;
  color: var(--color-primary);
  font-weight: bold;
}
.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: var(--color-primary);
  border-radius: 0 3rpx 3rpx 0;
}

/* 商品列表 */
.product-list {
  flex: 1;
  height: 100%;
  padding: 0 20rpx;
}

/* 分类分组 */
.cat-section {
  padding-bottom: 8rpx;
}
.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1a1a1a;
  padding: 24rpx 0 12rpx;
}
/* 底部留白，避免最后一组商品被购物车栏遮挡 */
.list-bottom {
  height: 140rpx;
}
.product-card {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.product-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.product-name { font-size: 28rpx; font-weight: 500; }
.product-desc { font-size: 22rpx; color: var(--color-text-light); }
.product-sales { font-size: 22rpx; color: var(--color-text-light); }
.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.product-price { font-size: 30rpx; color: var(--color-primary); font-weight: bold; }
.price-from { font-size: 22rpx; color: var(--color-text-light); font-weight: normal; }
.select-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

/* 未选门店 */
.no-store {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
}
.no-store-icon { width: 120rpx; height: 120rpx; opacity: 0.3; }
.no-store-text { font-size: 28rpx; color: var(--color-text-light); }

/* 门店休息遮罩 */
.closed-overlay {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.7);
  color: #fff;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  z-index: 50;
}
.closed-hours { display: block; font-size: 22rpx; margin-top: 8rpx; opacity: 0.7; }

/* 购物车栏 - 与套餐选择页 bottom-bar 统一风格：白底 + 阴影 */
.cart-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.08);
  position: relative;
  z-index: 100;
}
.cart-icon-wrap {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cart-icon {
  width: 44rpx;
  height: 44rpx;
}
.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
}
.cart-price {
  flex: 1;
  margin-left: 24rpx;
}
.cart-price .price {
  color: #1a1a1a;
  font-size: 40rpx;
  font-weight: bold;
}
.checkout-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 20rpx 36rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-left: auto;
  flex-shrink: 0;
}
.checkout-btn.disabled {
  background: #d1d1d1;
  color: #fff;
  pointer-events: none;
}

/* 已选餐品弹层 */
.cart-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(0, 0, 0, 0);
  transition: background 0.25s ease;
  pointer-events: none;
}
.cart-panel-mask.show {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}
.cart-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  /* 低于 cart-bar(100)，滑动过程中从购物车栏"后面"升起，不会遮挡底栏 */
  z-index: 95;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  /* 收起时整体移出屏幕外并隐藏，避免残留一条露出来 */
  transform: translateY(120%);
  visibility: hidden;
  transition: transform 0.25s ease, visibility 0.25s;
  display: flex;
  flex-direction: column;
  /* 展开后占据大部分页面 */
  height: 75vh;
}
.cart-panel.show {
  transform: translateY(0);
  visibility: visible;
}
.cart-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}
.cart-panel-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
}
.cart-panel-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.close-icon {
  font-size: 40rpx;
  color: var(--color-text-light);
  line-height: 48rpx;
}
.cart-panel-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 30rpx;
  -webkit-overflow-scrolling: touch;
}
.cart-panel-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.cart-panel-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.cart-panel-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}
.cart-panel-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-panel-spec {
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-panel-right {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
}
.cart-panel-price {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: bold;
}
.cart-panel-del {
  margin-top: 12rpx;
  padding: 8rpx;
}
.del-icon {
  font-size: 32rpx;
  color: var(--color-text-light);
}
.cart-panel-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: var(--color-text-light);
}
