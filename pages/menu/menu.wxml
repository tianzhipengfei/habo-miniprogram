<!-- 点单页 -->
<view class="page">
  <!-- 门店信息 -->
  <view class="store-bar" bindtap="goStores">
    <view class="store-info">
      <text class="store-name">{{store.name || '请选择门店'}}</text>
      <text class="store-distance" wx:if="{{store.distance}}">{{store.distance}}km</text>
    </view>
    <text class="switch-store">切换门店 ›</text>
  </view>

  <!-- 活动公告 -->
  <view class="notice-bar" wx:if="{{store.id}}">
    <text class="notice-text">充值福利，快来储蓄叭~</text>
    <text class="notice-more">更多</text>
  </view>

  <!-- 推荐商品 -->
  <scroll-view class="recommend-row" scroll-x wx:if="{{recommends.length > 0}}">
    <view class="recommend-item" wx:for="{{recommends}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="rec-img" src="{{item.image}}" mode="aspectFill" />
      <text class="rec-name">{{item.name}}</text>
      <text class="rec-price">¥{{item.price}}</text>
    </view>
  </scroll-view>

  <!-- 商品区 -->
  <view class="content" wx:if="{{store.id}}">
    <!-- 左侧分类 -->
    <scroll-view class="category-list" scroll-y>
      <view
        class="category-item {{currentCategory === index ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        wx:for-index="index"
        bindtap="switchCategory"
        data-index="{{index}}"
      >
        <image class="category-icon" src="{{item.icon}}" mode="aspectFit" />
        <text>{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧商品：所有商品按分类纵向排列 -->
    <scroll-view
      class="product-list"
      scroll-y
      scroll-into-view="{{scrollIntoView}}"
      scroll-with-animation
      bindscroll="onProductScroll"
    >
      <view
        class="cat-section"
        wx:for="{{categorySections}}"
        wx:key="category.id"
        id="cat-{{item.category.id}}"
      >
        <view class="section-title">{{item.category.name}}</view>
        <view
          class="product-card"
          wx:for="{{item.products}}"
          wx:for-item="prod"
          wx:key="id"
          bindtap="goDetail"
          data-id="{{prod.id}}"
        >
          <image class="product-img" src="{{prod.image}}" mode="aspectFill" />
          <view class="product-info">
            <text class="product-name">{{prod.name}}</text>
            <text class="product-desc" wx:if="{{prod.description}}">{{prod.description}}</text>
            <text class="product-sales">销量：{{prod.sales_count}}</text>
            <view class="product-bottom">
              <text class="product-price">¥{{prod.price}}<text class="price-from" wx:if="{{prod.is_combo}}"> 起</text></text>
              <view class="select-btn" catchtap="quickAdd" data-item="{{prod}}">
                <text>选择</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <empty-state wx:if="{{categorySections.length === 0 && !loading}}" text="暂无商品" />
      <view class="list-bottom"></view>
    </scroll-view>
  </view>

  <!-- 未选门店 -->
  <view class="no-store" wx:if="{{!store.id}}">
    <image class="no-store-icon" src="/images/icon-store.png" mode="aspectFit" />
    <text class="no-store-text">请先选择门店</text>
    <view class="btn btn-primary" bindtap="goStores">选择门店</view>
  </view>

  <!-- 门店休息中遮罩 -->
  <view class="closed-overlay" wx:if="{{store.id && store.status === 0}}">
    <text>门店休息中</text>
    <text class="closed-hours">营业时间：{{store.business_hours}}</text>
  </view>

  <!-- 底部购物车栏 -->
  <view class="cart-bar" wx:if="{{store.id}}">
    <view class="cart-icon-wrap" bindtap="toggleCartPanel">
      <image class="cart-icon" src="/images/menu/icon-cart.png" mode="aspectFit" />
      <text class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
    </view>
    <view class="cart-price" wx:if="{{cartCount > 0}}" bindtap="toggleCartPanel">
      <text class="price">¥{{cartTotal}}</text>
    </view>
    <view class="checkout-btn {{cartCount === 0 || store.status === 0 ? 'disabled' : ''}}" bindtap="goCheckout">
      <text>去结算</text>
    </view>
  </view>

  <!-- 已选餐品弹层遮罩 -->
  <view class="cart-panel-mask {{showCartPanel ? 'show' : ''}}" bindtap="closeCartPanel"></view>

  <!-- 已选餐品弹层内容 -->
  <view class="cart-panel {{showCartPanel ? 'show' : ''}}" catchtap="noop">
    <!-- 弹层头部 -->
    <view class="cart-panel-header">
      <text class="cart-panel-title">已选餐品</text>
      <view class="cart-panel-close" bindtap="closeCartPanel">
        <text class="close-icon">×</text>
      </view>
    </view>

    <!-- 商品列表 -->
    <scroll-view class="cart-panel-list" scroll-y>
      <view class="cart-panel-item" wx:for="{{cartItems}}" wx:key="id">
        <image class="cart-panel-img" src="{{item.product_image}}" mode="aspectFill" />
        <view class="cart-panel-info">
          <text class="cart-panel-name">{{item.product_name}}</text>
          <text class="cart-panel-spec">{{item.specText}}</text>
        </view>
        <view class="cart-panel-right">
          <text class="cart-panel-price">¥{{item.price}}</text>
          <view class="cart-panel-del" bindtap="removeCartItem" data-id="{{item.id}}">
            <text class="del-icon">🗑</text>
          </view>
        </view>
      </view>
      <view class="cart-panel-empty" wx:if="{{cartItems.length === 0}}">
        <text>购物车是空的</text>
      </view>
    </scroll-view>
  </view>
</view>
