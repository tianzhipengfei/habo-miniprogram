.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 160rpx; }
.section { background: #fff; margin-bottom: 20rpx; padding: 30rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; }

.store-name { font-size: 28rpx; font-weight: 500; display: block; }
.store-addr { font-size: 24rpx; color: var(--color-text-light); margin-top: 8rpx; display: block; }

.type-selector { display: flex; gap: 16rpx; }
.type-item {
  padding: 14rpx 32rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  font-size: 26rpx;
}
.type-item.active { background: var(--color-orange-light); color: var(--color-primary); font-weight: bold; }

.dinein-info { margin-top: 20rpx; }
.info-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--color-border); }
.info-label { font-size: 28rpx; }
.info-input { text-align: right; font-size: 28rpx; flex: 1; margin-left: 20rpx; }

.order-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--color-border); }
.order-item:last-child { border-bottom: none; }
.item-img { width: 80rpx; height: 80rpx; border-radius: 8rpx; background: #f5f5f5; }
.item-info { flex: 1; margin-left: 16rpx; }
.item-name { font-size: 26rpx; }
.item-qty { font-size: 22rpx; color: var(--color-text-light); margin-left: 8rpx; }
.item-price { font-size: 28rpx; font-weight: 500; }

.amount-row { display: flex; justify-content: space-between; padding: 12rpx 0; }
.amount-label { font-size: 26rpx; color: var(--color-text-secondary); }
.amount-value { font-size: 26rpx; }
.amount-row.total { border-top: 1rpx solid var(--color-border); margin-top: 12rpx; padding-top: 20rpx; }
.amount-row.total .amount-label { font-size: 30rpx; color: var(--color-text); font-weight: bold; }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}
.total-info { flex: 1; }
.total-label { font-size: 24rpx; color: var(--color-text-light); display: block; }
.submit-btn {
  background: var(--color-primary);
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}
